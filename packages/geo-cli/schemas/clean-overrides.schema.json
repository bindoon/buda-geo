{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-clean-overrides",
  "type": "object",
  "required": ["app_id", "assets", "products"],
  "properties": {
    "app_id": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_path", "action"],
        "properties": {
          "source_path": { "type": "string" },
          "action": { "enum": ["product", "company", "ignore"] },
          "product_name": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "is_main", "source_paths", "selling_points", "attributes", "capabilities"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "is_main": { "type": "boolean" },
          "source_paths": { "type": "array", "items": { "type": "string" } },
          "fact_source_paths": { "type": "array", "items": { "type": "string" } },
          "selling_points": { "type": "array", "items": { "type": "string" } },
          "attributes": { "type": "object" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "fact_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "field", "value", "reason"],
        "properties": {
          "subject": { "const": "company" },
          "field": { "type": "string", "minLength": 1 },
          "value": {},
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["block", "recommend", "optional"] },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
