{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-facts",
  "type": "object",
  "required": ["app_id", "generated_at", "inputs_hash", "facts_hash", "subjects", "facts", "conflicts"],
  "properties": {
    "app_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string" },
    "inputs_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "facts_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_id", "type", "name", "parent_subject_id", "source_refs", "review_status"],
        "properties": {
          "subject_id": { "type": "string" },
          "type": { "enum": ["company", "brand", "product", "product_family", "capability", "service", "asset"] },
          "name": { "type": "string", "minLength": 1 },
          "parent_subject_id": { "type": ["string", "null"] },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "review_status": { "enum": ["candidate", "confirmed", "rejected", "needs_clarification"] }
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "subject_id", "field", "value", "unit", "source_refs", "derivation", "confidence", "review_status", "disclosure_level"],
        "properties": {
          "fact_id": { "type": "string" },
          "subject_id": { "type": "string" },
          "field": { "type": "string", "minLength": 1 },
          "value": {},
          "unit": { "type": ["string", "null"] },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "derivation": { "enum": ["extracted", "inferred", "operator", "legacy"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "review_status": { "enum": ["candidate", "confirmed", "rejected", "needs_clarification"] },
          "disclosure_level": { "enum": ["public", "restricted", "internal"] }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "subject_id", "field", "candidate_fact_ids", "severity", "status", "resolution"],
        "properties": {
          "conflict_id": { "type": "string" },
          "subject_id": { "type": "string" },
          "field": { "type": "string" },
          "candidate_fact_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "severity": { "enum": ["block", "recommend", "optional"] },
          "status": { "enum": ["unresolved", "resolved", "accepted"] },
          "resolution": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
