{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-scenario-library",
  "type": "object",
  "required": ["schema_version", "scenario_library_id", "app_id", "fact_snapshot_id", "diagnosis_report_id", "diagnosis_gap_path", "lifecycle", "version", "based_on_scenario_library_id", "created_at", "confirmed_at", "scenarios", "merge_suggestions", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario_library_id": { "type": "string", "pattern": "^scenario_library_" },
    "app_id": { "type": "string", "minLength": 1 },
    "fact_snapshot_id": { "type": "string", "pattern": "^fact_snapshot_" },
    "diagnosis_report_id": { "type": "string", "pattern": "^diagnosis_report_" },
    "diagnosis_gap_path": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["draft", "review_required", "confirmed", "retired"] },
    "version": { "type": "integer", "minimum": 1 },
    "based_on_scenario_library_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "confirmed_at": { "type": ["string", "null"], "format": "date-time" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "merge_suggestions": { "type": "array", "items": { "$ref": "#/$defs/mergeSuggestion" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sourceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref_id", "kind", "ref_id", "path", "original_bucket", "text", "derivation"],
      "properties": {
        "source_ref_id": { "type": "string", "pattern": "^scenario_source_" },
        "kind": { "enum": ["fact", "diagnosis_gap", "legacy_keyword", "customer_language", "operator"] },
        "ref_id": { "type": "string", "minLength": 1 }, "path": { "type": ["string", "null"] },
        "original_bucket": { "type": ["string", "null"] }, "text": { "type": ["string", "null"] },
        "derivation": { "enum": ["extracted", "derived", "operator", "legacy"] }
      }
    },
    "facets": {
      "type": "object", "additionalProperties": false,
      "required": ["wording_form", "regions", "decision_stage", "direction", "product_subject_ids", "capability_terms", "constraints"],
      "properties": {
        "wording_form": { "enum": ["direct_question", "comparison", "recommendation", "how_to", "risk"] },
        "regions": { "type": "array", "items": { "type": "string" } },
        "decision_stage": { "enum": ["awareness", "consideration", "supplier_selection", "purchase", "post_purchase"] },
        "direction": { "enum": ["positive", "neutral", "negative"] },
        "product_subject_ids": { "type": "array", "items": { "type": "string", "pattern": "^sub_" } },
        "capability_terms": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "text", "normalized_text", "facets", "fact_ids", "evidence_gap_ids", "source_refs"],
      "properties": {
        "question_id": { "type": "string", "pattern": "^scenario_question_" }, "text": { "type": "string", "minLength": 2 }, "normalized_text": { "type": "string", "minLength": 1 },
        "facets": { "$ref": "#/$defs/facets" }, "fact_ids": { "type": "array", "items": { "type": "string", "pattern": "^fact_" } },
        "evidence_gap_ids": { "type": "array", "items": { "type": "string", "pattern": "^evidence_gap_" } },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "evidenceGap": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_gap_id", "kind", "severity", "description", "scenario_id", "question_ids", "fact_ids", "source_refs", "status", "review_reason"],
      "properties": {
        "evidence_gap_id": { "type": "string", "pattern": "^evidence_gap_" }, "kind": { "enum": ["business_evidence", "probe_coverage"] },
        "severity": { "enum": ["high", "medium", "low"] }, "description": { "type": "string", "minLength": 2 }, "scenario_id": { "type": "string", "pattern": "^scenario_" },
        "question_ids": { "type": "array", "items": { "type": "string", "pattern": "^scenario_question_" } },
        "fact_ids": { "type": "array", "items": { "type": "string", "pattern": "^fact_" } }, "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "status": { "enum": ["open", "deferred", "accepted", "resolved"] }, "review_reason": { "type": ["string", "null"] }
      }
    },
    "priority": {
      "type": "object", "additionalProperties": false,
      "required": ["components", "calculated_total", "final_score", "tier", "rationale", "override"],
      "properties": {
        "components": { "type": "object", "additionalProperties": false, "required": ["business_value", "diagnosis_gap", "evidence_readiness", "customer_language", "operator_judgment"], "properties": {
          "business_value": { "type": "number", "minimum": 0, "maximum": 5 }, "diagnosis_gap": { "type": "number", "minimum": 0, "maximum": 5 },
          "evidence_readiness": { "type": "number", "minimum": 0, "maximum": 5 }, "customer_language": { "type": "number", "minimum": 0, "maximum": 5 },
          "operator_judgment": { "type": "number", "minimum": 0, "maximum": 5 }
        } },
        "calculated_total": { "type": "number", "minimum": 0, "maximum": 25 }, "final_score": { "type": "number", "minimum": 0, "maximum": 25 },
        "tier": { "enum": ["high", "medium", "low"] }, "rationale": { "type": "array", "items": { "type": "string" } },
        "override": { "oneOf": [
          { "type": "null" },
          { "type": "object", "additionalProperties": false, "required": ["score", "actor", "reason", "at"], "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 25 }, "actor": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }, "at": { "type": "string", "format": "date-time" }
          } }
        ] }
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "name", "target_customer", "customer_need", "concerns", "representative_questions", "supporting_fact_ids", "evidence_gaps", "source_refs", "desired_next_action", "priority", "review_status", "review_note"],
      "properties": {
        "scenario_id": { "type": "string", "pattern": "^scenario_" }, "name": { "type": "string", "minLength": 2 }, "target_customer": { "type": "string", "minLength": 2 },
        "customer_need": { "type": "string", "minLength": 2 }, "concerns": { "type": "array", "items": { "type": "string" } },
        "representative_questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } },
        "supporting_fact_ids": { "type": "array", "items": { "type": "string", "pattern": "^fact_" } }, "evidence_gaps": { "type": "array", "items": { "$ref": "#/$defs/evidenceGap" } },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "desired_next_action": { "type": ["object", "null"], "required": ["type", "label", "url"], "properties": { "type": { "enum": ["request_quote", "visit_shop", "contact_sales", "learn_more"] }, "label": { "type": "string" }, "url": { "type": ["string", "null"] } } },
        "priority": { "$ref": "#/$defs/priority" }, "review_status": { "enum": ["unreviewed", "approved", "rejected", "deferred"] }, "review_note": { "type": ["string", "null"] }
      }
    },
    "mergeSuggestion": {
      "type": "object", "additionalProperties": false,
      "required": ["suggestion_id", "item_type", "item_ids", "reason", "similarity", "meaningful_differences", "status", "review_reason"],
      "properties": {
        "suggestion_id": { "type": "string", "pattern": "^merge_suggestion_" }, "item_type": { "enum": ["scenario", "question"] },
        "item_ids": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^(scenario_|scenario_question_)" } },
        "reason": { "type": "string" }, "similarity": { "type": "number", "minimum": 0, "maximum": 1 }, "meaningful_differences": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["pending", "approved", "rejected"] }, "review_reason": { "type": ["string", "null"] }
      }
    }
  },
  "additionalProperties": false
}
