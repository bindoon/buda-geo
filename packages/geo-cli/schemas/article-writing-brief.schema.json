{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-article-writing-brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "slot",
    "app_id",
    "content_plan_id",
    "content_plan_version",
    "task_id",
    "topic_id",
    "faq_ids",
    "scenario_ids",
    "question_ids",
    "fact_snapshot_id",
    "channel",
    "content_format",
    "mode",
    "title_direction",
    "objective",
    "audience",
    "questions",
    "desired_next_action",
    "outline_requirements",
    "tone",
    "channel_constraints",
    "citation_policy",
    "allowed_facts",
    "allowed_images",
    "forbidden_claims",
    "claim_boundaries",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "article_id": { "type": "string" },
    "slot": { "type": "integer", "minimum": 1 },
    "app_id": { "type": "string" },
    "content_plan_id": { "type": "string" },
    "content_plan_version": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string" },
    "topic_id": { "type": "string" },
    "faq_ids": { "$ref": "#/$defs/strings" },
    "scenario_ids": { "$ref": "#/$defs/strings" },
    "question_ids": { "$ref": "#/$defs/strings" },
    "fact_snapshot_id": { "type": "string" },
    "channel": { "enum": ["social", "media", "b2b", "site"] },
    "content_format": { "type": "string" },
    "mode": { "enum": ["factual", "research_only"] },
    "title_direction": { "type": "string" },
    "objective": { "type": "string" },
    "audience": { "type": "string" },
    "questions": { "$ref": "#/$defs/strings" },
    "desired_next_action": { "type": ["object", "null"] },
    "outline_requirements": { "$ref": "#/$defs/strings" },
    "tone": { "type": "string" },
    "channel_constraints": { "$ref": "#/$defs/strings" },
    "citation_policy": { "type": "string" },
    "allowed_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "field", "value"],
        "properties": {
          "fact_id": { "type": "string" },
          "field": { "type": "string" },
          "value": {}
        }
      }
    },
    "allowed_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sku_id", "sku_name", "markdown_path"],
        "properties": {
          "path": { "type": "string", "pattern": "^assets/images/" },
          "role": { "type": "string" },
          "sku_id": { "type": "string" },
          "sku_name": { "type": "string" },
          "markdown_path": { "type": "string" },
          "alt": { "type": "string" }
        }
      }
    },
    "forbidden_claims": { "$ref": "#/$defs/strings" },
    "claim_boundaries": { "$ref": "#/$defs/strings" },
    "created_at": { "type": "string" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
