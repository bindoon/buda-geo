{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-publishing-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "app_id", "content_plan_id", "created_at", "status", "authorized_at", "authorized_by", "authorization_id", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^publish_plan_" },
    "app_id": { "type": "string", "minLength": 1 },
    "content_plan_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["prepared", "authorized", "in_progress", "complete", "complete_with_failures"] },
    "authorized_at": { "type": ["string", "null"], "format": "date-time" },
    "authorized_by": { "type": ["string", "null"] },
    "authorization_id": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "article_id", "article_title", "body_path", "body_sha256", "channel", "destination_id", "destination_name", "execution_mode", "idempotency_key", "status", "attempt_count", "latest_receipt_id"],
        "properties": {
          "item_id": { "type": "string", "pattern": "^publish_item_" },
          "article_id": { "type": "string", "pattern": "^article_" },
          "article_title": { "type": "string", "minLength": 1 },
          "body_path": { "type": "string", "pattern": "^articles/(social|media|b2b|site)/" },
          "body_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "channel": { "enum": ["social", "media", "b2b", "site"] },
          "destination_id": { "type": "string", "pattern": "^destination_" },
          "destination_name": { "type": "string", "minLength": 1 },
          "execution_mode": { "enum": ["manual", "adapter"] },
          "idempotency_key": { "type": "string", "pattern": "^publish_key_[a-f0-9]{16}$" },
          "status": { "enum": ["planned", "submitted", "published", "failed", "skipped"] },
          "attempt_count": { "type": "integer", "minimum": 0 },
          "latest_receipt_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
