{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "geo-diagnosis-run", "type": "object",
  "required": ["schema_version", "run_id", "app_id", "fact_snapshot_id", "seed_set_id", "created_at", "status", "requested_platforms", "probe_ids"],
  "properties": {
    "schema_version": { "const": 1 }, "run_id": { "type": "string", "pattern": "^diagnosis_run_" }, "app_id": { "type": "string" }, "fact_snapshot_id": { "type": "string", "pattern": "^fact_snapshot_" },
    "seed_set_id": { "type": "string", "pattern": "^seed_set_" }, "created_at": { "type": "string", "format": "date-time" }, "status": { "enum": ["prepared", "in_progress", "complete_with_failures", "complete"] },
    "requested_platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "probe_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^probe_" } }
  }, "additionalProperties": false
}
