{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-skus",
  "type": "object",
  "required": ["app_id", "items"],
  "properties": {
    "app_id": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
          "required": ["sku_id", "name", "category", "selling_points", "attributes", "capabilities", "is_main", "source_refs", "fact_refs", "images"],
        "properties": {
          "sku_id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "selling_points": { "type": "array" },
          "attributes": { "type": "object" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "is_main": { "type": "boolean" },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "fact_refs": { "type": "array", "items": { "type": "string" } },
          "copy_brief": {},
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "source_ref"],
              "properties": {
                "path": { "type": "string" },
                "role": { "type": "string" },
                "url": {}
                ,"source_ref": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
