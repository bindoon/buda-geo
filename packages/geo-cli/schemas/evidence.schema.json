{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-evidence",
  "type": "object",
  "required": ["app_id", "generated_at", "items"],
  "properties": {
    "app_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "subject_refs", "source_ref", "path", "supports_fact_ids", "disclosure_level", "review_status", "valid_from", "valid_until", "notes"],
        "properties": {
          "evidence_id": { "type": "string" },
          "type": { "type": "string", "minLength": 1 },
          "subject_refs": { "type": "array", "items": { "type": "string" } },
          "source_ref": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "supports_fact_ids": { "type": "array", "items": { "type": "string" } },
          "disclosure_level": { "enum": ["public", "restricted", "internal"] },
          "review_status": { "enum": ["candidate", "confirmed", "rejected", "needs_clarification"] },
          "valid_from": { "type": ["string", "null"] },
          "valid_until": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
