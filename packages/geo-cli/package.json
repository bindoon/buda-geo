{
  "name": "@bindoon/geo-cli",
  "version": "0.1.0",
  "description": "Local-first, evidence-backed GEO workflow CLI for Buda GEO",
  "type": "module",
  "bin": {
    "geo-cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "schemas",
    "bundled-skills"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "dev": "tsx src/cli.ts",
    "stage-skills": "node scripts/stage-skills.mjs stage",
    "clean-staged-skills": "node scripts/stage-skills.mjs clean",
    "prepack": "npm run build && npm run stage-skills",
    "postpack": "npm run clean-staged-skills",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "buda-geo",
    "geo",
    "generative-engine-optimization",
    "cli",
    "knowledge-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bindoon/buda-geo.git",
    "directory": "packages/geo-cli"
  },
  "homepage": "https://github.com/bindoon/buda-geo#readme",
  "bugs": {
    "url": "https://github.com/bindoon/buda-geo/issues"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "jszip": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
