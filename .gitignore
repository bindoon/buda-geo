# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.cursor/

# Secrets — never commit
.env
.env.*
!.env.example
config/probe-platforms.json
**/.secrets.env
**/*.pem
**/credentials.json

# Office lock / temp
~$*
*.tmp

# Node / Python
node_modules/
dist/
build/
packages/geo-cli/bundled-skills/
.coverage
.pytest_cache/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Logs & caches
*.log
.npm/
.cache/
.playwright-cli/
.codex

# Optional local dumps (keep docs 摸底 markdown; ignore bulky raw if re-generated)
# Uncomment if raw snapshots should stay local-only:
# docs/各GEO平台资料/平台摸底/*-raw/
# docs/各GEO平台资料/平台摸底/*-raw-clean/

# Client workspaces stay on disk; only 知鱼 is versioned
projects/*
!projects/registry.json
!projects/知鱼/
!projects/知鱼/**

# Raw inputs, local assets, and generated articles stay out of git
projects/*/inputs
projects/*/assets
projects/*/articles

openspec
docs/**/*.pptx
docs/**/*.pdf
docs/**/平台摸底/**/*-raw/
docs/**/平台摸底/**/*-raw-clean/
