# Buda GEO local runtime configuration
# Copy this file to .env. Never commit .env or real credentials.

# Probe provider registry. Copy the example JSON before first use:
#   cp config/probe-platforms.example.json config/probe-platforms.json
BUDA_PROBE_CONFIG=./config/probe-platforms.json

# DeepSeek (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Alibaba Cloud Model Studio / Qwen (adjust URL/model for your account and region)
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=

# Volcano Engine / Doubao (adjust URL/model endpoint for your account)
DOUBAO_BASE_URL=
DOUBAO_API_KEY=
DOUBAO_MODEL=

# Any other OpenAI-compatible provider
CUSTOM_PROBE_BASE_URL=
CUSTOM_PROBE_API_KEY=
CUSTOM_PROBE_MODEL=

# Publishing adapter reservation. The current open-source release never calls
# these automatically; destination registries reference the variable names only.
MEDIA_PUBLISH_ENDPOINT=
MEDIA_PUBLISH_TOKEN=
B2B_PUBLISH_ENDPOINT=
B2B_PUBLISH_TOKEN=
SOCIAL_PUBLISH_ENDPOINT=
SOCIAL_PUBLISH_TOKEN=
SITE_PUBLISH_ENDPOINT=
SITE_PUBLISH_TOKEN=
